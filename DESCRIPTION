Type: Package
Package: rjd3tramoseats
Title: Seasonal Adjustment with TRAMO-SEATS in 'JDemetra+' 3.x
Version: 3.8.0.9000
Authors@R: c(
    person("Jean", "Palate", , "palatejean@gmail.com", role = "aut"),
